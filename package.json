{
  "name": "ssnodefullstack",
  "version": "0.1.0",
  "description": "SSNodeFullStack — 脚手架源仓(create-ssnode-app CLI + templates)",
  "private": true,
  "engines": {
    "node": ">=20.11.0"
  },
  "workspaces": [
    "cli",
    "templates/web",
    "templates/backend"
  ],
  "scripts": {
    "cli": "node cli/index.js",
    "dev": "pnpm --filter web --filter backend --parallel run dev",
    "build": "pnpm --filter web --filter backend run build",
    "lint": "pnpm -r run lint",
    "test": "pnpm --filter create-ssnode-app run test"
  },
  "devDependencies": {
    "node-ssh": "13.1.0",
    "shelljs": "0.8.5"
  },
  "pnpm": {
    "requiredScripts": []
  }
}
