# docker compose 部署配置(复制为 .env 后改值)。
# 镜像由 docker/install.sh 以 current/ 为 build context 现场构建 <IMAGE>:<TAG>,此处只引用 IMAGE/TAG。
# 配置以环境变量注入(configuration.ts 读 env,缺省回退镜像内 yaml)。

# 镜像名 & tag(tag = <version>-<14位ts>,每次部署一个新 tag,旧 tag 留作回滚)。
# IMAGE 默认 fullstack-template-backend(与 docker/install.sh 的 config.sh 一致,通常不用改)。TAG 必填。
IMAGE=fullstack-template-backend
TAG=

# 容器名。
CONTAINER_NAME=fullstack-template-backend

# 数据根目录(宿主路径,bind mount 进容器 /app/data,跨版本/镜像共享、轮转不动)。
# db/backup/logs/uploads 全部落此根的子目录,后续追加新子目录无需再加 mount。必填。
DATA_DIR=

# 运行端口(docker 权威 = 此 PORT env;app 读 PORT 监听,宿主映射 = 容器监听 = PORT)。
# 迁移新机只改此值即可换端口;systemd/pm2 模式端口权威在 config.prod.yaml,与此无关。
PORT=3001

# 业务配置(env override,空则用镜像内 config/prod.yaml 缺省)。
# 注意:DB_DIR/UPLOAD_STORAGE_PATH 已在 docker run/compose 内置(随 /app/data mount 目标锁定),
#       此处不再暴露,避免部署期改容器内路径致数据写飞(非持久化目录)。
NODE_ENV=prod
CORS_ORIGINS=
# ⚠️ 模板占位:新项目务必换成自己的强密钥(与 config.prod.yaml / web/.env.production 同款)。
# 种子化 .env 时一并带入,免部署期空值阻断。
# 轮换:改本文件 + 重新部署,或直接改服务器 APP_ROOT/.env + 重启容器。
JWT_SECRET=
JWT_EXPIRES=8h
LOG_LEVEL=warn
ADMIN_PASSWORD=
APP_SIGN_KEY=
APP_SIGN_TS_WINDOW=300
