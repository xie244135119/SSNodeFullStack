{
  "name": "backend",
  "version": "1.0.2",
  "description": "全栈模板 - 后台服务(NestJS + SQLite + TypeORM)",
  "private": true,
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "node scripts/build.cjs build",
    "buildops": "node scripts/build.cjs buildops",
    "publish": "node scripts/publish.cjs",
    "rollback": "node scripts/rollback.cjs",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint src --ext ts --fix",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:generate": "TS_NODE_PROJECT=tsconfig.migration.json typeorm-ts-node-commonjs migration:generate --pretty -d scripts/data-source.ts"
  },
  "dependencies": {
    "@nestjs/axios": "4.0.1",
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/platform-socket.io": "11.1.28",
    "@nestjs/serve-static": "5.0.5",
    "@nestjs/swagger": "11.4.6",
    "@nestjs/throttler": "6.5.0",
    "@nestjs/typeorm": "11.0.3",
    "@nestjs/websockets": "11.1.28",
    "bcryptjs": "2.4.3",
    "better-sqlite3": "13.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "js-yaml": "4.1.0",
    "multer": "1.4.5-lts.1",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "passport-local": "1.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.3",
    "svg-captcha": "1.4.0",
    "typeorm": "0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.1.28",
    "@types/bcryptjs": "2.4.6",
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/js-yaml": "4.0.9",
    "@types/multer": "1.4.12",
    "@types/node": "26.1.2",
    "@types/passport-jwt": "4.0.1",
    "@types/passport-local": "1.0.38",
    "@typescript-eslint/eslint-plugin": "8.66.0",
    "@typescript-eslint/parser": "8.66.0",
    "eslint": "8.57.0",
    "eslint-config-prettier": "10.1.8",
    "source-map-support": "0.5.21",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.4.3"
  }
}
